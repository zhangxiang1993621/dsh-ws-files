{
  "name": "dsh-ws-files",
  "version": "0.1.4",
  "description": "工作空间文件浏览器：树形目录浏览、搜索、在线编辑，注册进布局左/右区域，文件在对话/轨迹同级标签页打开",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "layout"
      ]
    }
  },
  "license": "MIT"
}
